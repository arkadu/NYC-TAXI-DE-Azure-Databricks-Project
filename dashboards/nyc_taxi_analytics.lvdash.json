{
  "datasets": [
    {
      "name": "zone_revenue",
      "displayName": "Zone Revenue",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.zone_revenue"
      ]
    },
    {
      "name": "daily_borough_metrics",
      "displayName": "Daily Borough Metrics",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.daily_borough_metrics"
      ]
    },
    {
      "name": "payment_trends",
      "displayName": "Payment Trends",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.payment_trends"
      ],
      "columns": [
        {
          "displayName": "Payment Method",
          "expression": "CASE `payment_type` WHEN 1 THEN 'Credit Card' WHEN 2 THEN 'Cash' WHEN 3 THEN 'No Charge' WHEN 4 THEN 'Dispute' ELSE 'Unknown' END"
        }
      ]
    },
    {
      "name": "airport_metrics",
      "displayName": "Airport Metrics",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.airport_metrics"
      ],
      "columns": [
        {
          "displayName": "JFK Total Trips",
          "expression": "`jfk_pickups` + `jfk_dropoffs`"
        },
        {
          "displayName": "LaGuardia Total Trips",
          "expression": "`laguardia_pickups` + `laguardia_dropoffs`"
        },
        {
          "displayName": "Newark Total Trips",
          "expression": "`newark_pickups` + `newark_dropoffs`"
        }
      ]
    },
    {
      "name": "hourly_demand",
      "displayName": "Hourly Demand",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.hourly_demand"
      ]
    },
    {
      "name": "trip_type_summary",
      "displayName": "Trip Type Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  nyctaxi_databricks.gold.trip_type_summary"
      ]
    }
  ],
